upstream storage_origin {
    server ${STORAGE_ORIGIN};
}

server {
    listen 8080;
    server_name _;

    location / {
        proxy_pass http://storage_origin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";

        # Cache keyed on path only, ignoring the query string. Presigned
        # URLs carry a unique signature + expiry per request, so keying on
        # the full URL would give every viewer's link its own cache entry
        # and never actually share a hit — this way every viewer requesting
        # the same segment hits the same cache entry.
        #
        # Known tradeoff: because of that, a cache HIT never reaches the
        # storage origin, which means a cached response is served without
        # re-checking whether *this specific* request's presigned signature
        # is valid or expired. That's fine as long as permission is enforced
        # before a URL is ever handed out (the app server only gives a
        # viewer a URL after confirming they own the movie) — it stops being
        # fine if this cache is ever treated as the sole access-control
        # point. If per-request revocation ever matters, add a
        # token-validation step (auth_request) in front of this location.
        proxy_cache movie_cache;
        proxy_cache_key "$scheme$request_method$host$uri";
        proxy_cache_valid 200 206 7d;
        proxy_cache_valid 404 1m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 30s;

        add_header X-Cache-Status $upstream_cache_status always;
    }
}
