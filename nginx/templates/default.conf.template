# Which UNSIGNED bucket paths are refused outright. The five arms ABOVE the
# `~^allow:` line are unconditional — they are refused in BOTH legacy modes,
# because none of them is something a player ever fetches. They are the
# SOURCE side of the layout (see backend/src/common/storage/media-taxonomy.ts):
# an archived original.* upload, every uploaded subtitle source under
# subtitles/, every document under documents/ (chapter PDFs live at
# documents/books/<b>/<e>/<c>/original.pdf), and the temp/ staging namespace.
# All of those are read by the backend itself over credentialed S3, never
# through this cache, so no rollout window applies to them.
#
# The rest is the rollout switch: LEGACY_UNSIGNED_MEDIA=allow keeps token-less
# HLS/page URLs working while old clients still hold them; =deny (the default)
# makes the signed locations below the ONLY way to a video segment, an audio
# segment or a book page. Images (/movies/images/**) are never listed here —
# posters and avatars stay plain and public, that is the whole point of a
# browsable catalogue.
map "${LEGACY_UNSIGNED_MEDIA}:$uri" $deny_unsigned_media {
    ~^[^:]*:/movies/videos/[^/]+/original\.   1;
    ~^[^:]*:/movies/audio/[^/]+/original\.    1;
    ~^[^:]*:/movies/subtitles/                1;
    ~^[^:]*:/movies/documents/                1;
    ~^[^:]*:/movies/temp/                     1;
    ~^allow:                                  0;
    ~^[^:]*:/movies/(videos|audio|books)/     1;
    default                                   0;
}

# Browser lifetime (Cache-Control max-age) for the signed "everything else"
# location below, chosen by the token's scope. Segments and book pages are
# immutable at their key: 30 days. Uploaded subtitle sources under
# subtitles/<movieId>/ keep the operator's own file name and may be replaced
# in place: 10 seconds, the same as playlists and .vtt text.
map $scope $signed_media_expires {
    ~^subtitles/   10s;
    default        30d;
}

# The cache itself: where it lives, the movie_cache zone every location
# uses, and its total size on disk. max_size is a plain number on purpose
# (5g, as before): a ${...} value here would leave a container created
# before that variable existed unable to start after any restart. On the
# real cache VPS edit the number to about 70-80% of the free disk and
# recreate the container. Entries unused for 7 days are dropped.
proxy_cache_path /var/cache/nginx levels=1:2 keys_zone=movie_cache:100m max_size=5g inactive=7d use_temp_path=off;

upstream storage_origin {
    server ${STORAGE_ORIGIN};
    # Reuse open connections to the storage origin instead of opening a new
    # TCP connection for every cache MISS. Needs proxy_http_version 1.1 and
    # an empty Connection header, both set in the server block below.
    keepalive 32;
}

server {
    listen 8080;
    server_name _;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";

    # MinIO judges the bucket policy's aws:SourceIp (anonymous reads only
    # from this cache's address — ../../storage-server/policies/) by
    # X-Forwarded-For / X-Real-IP / Forwarded BEFORE the socket address, and
    # nginx forwards whatever the viewer sent. Passed through, a viewer's
    # header — or one added by a TLS proxy in front of this cache — would make
    # MinIO judge a MISS by the viewer's address and refuse it. Blank values
    # make nginx drop the three headers, so MinIO only ever sees this cache.
    # Kept at server level on purpose: a location that sets any
    # proxy_set_header of its own inherits none of these.
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Real-IP "";
    proxy_set_header Forwarded "";
    # Same blanking, for cache efficiency rather than the bucket policy: MinIO
    # answers "Vary: Origin" and "Vary: Accept-Encoding", and nginx stored a
    # separate copy of the same object for every website address and every
    # browser's encoding list. The bytes never differ by either (this cache
    # sets the CORS headers itself, and MinIO does not compress), so neither
    # header is forwarded and Vary from MinIO is ignored and not passed on.
    # nginx's own gzip still sends a correct Vary to viewers (gzip_vary).
    proxy_set_header Origin "";
    proxy_set_header Accept-Encoding "";
    proxy_ignore_headers Vary;
    proxy_hide_header Vary;

    # MinIO's internal headers are no use to a viewer: request ids, its rate
    # limit counters, an old XSS header, and an HSTS header that means
    # nothing over plain HTTP (a TLS proxy in front sets its own). ETag,
    # Last-Modified, Content-Range, Accept-Ranges and X-Content-Type-Options
    # are kept. Like proxy_set_header, these are only inherited by locations
    # that define no proxy_hide_header of their own, so none of them does.
    proxy_hide_header X-Amz-Id-2;
    proxy_hide_header X-Amz-Request-Id;
    proxy_hide_header X-Ratelimit-Limit;
    proxy_hide_header X-Ratelimit-Remaining;
    proxy_hide_header X-Xss-Protection;
    proxy_hide_header Strict-Transport-Security;

    # Wildcard, not an origin allowlist. This cache IS the access-control
    # point for media now — but the control is the signed token in the
    # request PATH (checked by the /s/... locations below), not the caller's
    # origin: a token is minted by the backend only after it has verified
    # the viewer's subscription, and it is worthless once it expires. CORS
    # here only governs whether cross-origin JS can *read* the response,
    # which the custom HLS prefetch player needs (it fetches via XHR/fetch,
    # not a plain <video src>). Needed for any origin that legitimately runs
    # userwebsite, present or future, without maintaining a per-environment
    # origin list here too.
    #
    # Set at server level so every location below inherits one identical set:
    # an add_header anywhere inside a location would silently drop these.
    add_header Access-Control-Allow-Origin * always;
    # Content-Range/Accept-Ranges: byte-range seeking. ETag: the
    # player's own cache-freshness checks.
    add_header Access-Control-Expose-Headers "Content-Range, Content-Length, Accept-Ranges, ETag" always;
    add_header X-Cache-Status $upstream_cache_status always;

    # Cache keyed on the OBJECT path only — the query string is ignored, and
    # in the signed locations the /s/<expires>/<sig>/ prefix is stripped from
    # the key too (each of them restates proxy_cache_key without it). Every
    # token ever minted for one segment therefore lands on one cache entry:
    # a viewer whose link was signed at 14:00 and one whose link was signed
    # at 15:00 share a HIT, and an entry cached before this token scheme
    # existed carries straight over (the key string is byte-identical).
    #
    # The consequence to understand: the token is verified by THIS request
    # (secure_link runs before the cache lookup, on HIT and MISS alike), but
    # what is verified is "a valid, unexpired token for this title's scope",
    # never "this particular viewer". Anyone holding a live link for a title
    # can play that title until the link expires; per-viewer binding would
    # need an auth_request round trip to the backend per segment, which is
    # exactly the origin load this cache exists to remove. Revoking a
    # subscription therefore takes effect at the next stream lookup, not
    # mid-segment.
    #
    # Ignoring the query string also means a cache-busting query string
    # CANNOT force a refresh of a mutable object — which is why freshness has
    # to come from the TTL split below rather than from the publisher's URLs.
    proxy_cache movie_cache;
    proxy_cache_key "$scheme$request_method$host$uri";
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    proxy_cache_lock on;
    proxy_cache_lock_timeout 30s;
    # When a playlist's 10 s runs out, keep serving the old copy while ONE
    # background request refreshes it, instead of making a viewer wait on the
    # storage round trip. The refresh asks "changed since?" (ETag /
    # Last-Modified), so an unchanged playlist comes back as a tiny 304.
    proxy_cache_background_update on;
    proxy_cache_revalidate on;

    # Playlists and subtitle text are MUTABLE at a stable key, unlike segment
    # bytes. master.m3u8 in particular is rewritten in place every time a
    # subtitle is added, renamed, made default, or deleted (the subtitle
    # renditions live inside it as #EXT-X-MEDIA lines), and subs/<id>.vtt is
    # republished alongside it. Under the 7d TTL below, every one of those
    # edits would stay invisible for up to a week: a title whose master was
    # fetched before its subtitle existed would serve the subtitle-free
    # manifest, and after a delete the stale master would keep advertising a
    # rendition whose objects are gone. A few seconds is short enough that an
    # admin edit shows up on the next play, long enough to still absorb the
    # herd at the start of a popular title.
    #
    # ---- Signed media: /s/<expires>/<signature>/movies/<scope>/<rest> ----
    #
    # The backend (MinioService.signedPlaybackUrl) puts the token in the
    # PATH, not the query string, for one reason: a playlist's segment URIs
    # are relative (`720p/index.m3u8`, `segment_007.ts`), and every player
    # resolves them against the playlist's own URL — so a prefix on the
    # master URL is inherited by every segment for free, while a query
    # string would be dropped at the first relative hop. The token signs the
    # SCOPE (one title's hls/ folder, one chapter's pages/ folder, one
    # movie's subtitle-source folder `subtitles/<movieId>`), so a single
    # token covers everything under it.
    #
    #   secure_link_md5 "<expires> <scope> <secret>"  ==  base64url(md5(...))
    #
    # is the contract with backend/src/common/storage/stream-signature.ts,
    # and ${STREAM_SIGNING_SECRET} must be the backend's STREAM_SIGNING_SECRET
    # verbatim. $secure_link is "" for a bad signature (403), "0" for a good
    # signature past its expiry (410 — the clients treat that as "fetch a
    # fresh link", a 403 as "give up"), "1" to proceed.
    #
    # The scope alternation is GENERATED — it is not written by hand here.
    # `npx ts-node scripts/print-stream-scopes.ts` in the backend prints it
    # from MEDIA_CLASSES, and nginx-scopes.spec.ts fails when this file no
    # longer contains that exact string EXACTLY TWICE. It has to be identical
    # in both locations: changing one and forgetting the other breaks
    # playlists but not segments (or the reverse), which shows up as flaky
    # playback rather than as a config error. These two locations must also
    # precede the unsigned `\.(m3u8|vtt)$` one — nginx takes the first
    # matching regex location in file order — or a signed playlist would fall
    # through to the legacy handling.
    #
    # Playlists/subtitle text first (short TTL), then everything else under a
    # signed prefix (long TTL). Both restate the cache key WITHOUT the token
    # prefix — see the proxy_cache_key note above. The regexes are quoted
    # because nginx's config parser would otherwise trip on the `{36}`.
    location ~ "^/s/(?<exp>\d+)/(?<sig>[\w-]+)/movies/(?<scope>videos/[0-9a-f-]{36}/hls|audio/[0-9a-f-]{36}/hls|subtitles/[0-9a-f-]{36}|books/[0-9a-f-]{36}/[0-9a-f-]{36}/[0-9a-f-]{36}/pages)/(?<rest>.+\.(m3u8|vtt))$" {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin * always;
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Range, Content-Type" always;
            add_header Access-Control-Max-Age 86400 always;
            add_header Content-Length 0;
            add_header Content-Type text/plain;
            return 204;
        }

        secure_link $sig,$exp;
        secure_link_md5 "$exp $scope ${STREAM_SIGNING_SECRET}";
        if ($secure_link = "") { return 403; }
        if ($secure_link = "0") { return 410; }

        proxy_cache_key "$scheme$request_method$host/movies/$scope/$rest";
        proxy_pass http://storage_origin/movies/$scope/$rest;

        proxy_cache_valid 200 206 10s;
        proxy_cache_valid 404 1m;
        # Tell browsers the same 10 s (Cache-Control: max-age=10). `expires`,
        # unlike add_header, keeps the server-level CORS headers, and it only
        # applies to 2xx/3xx, so the 403/410 token answers stay uncached.
        expires 10s;
    }

    location ~ "^/s/(?<exp>\d+)/(?<sig>[\w-]+)/movies/(?<scope>videos/[0-9a-f-]{36}/hls|audio/[0-9a-f-]{36}/hls|subtitles/[0-9a-f-]{36}|books/[0-9a-f-]{36}/[0-9a-f-]{36}/[0-9a-f-]{36}/pages)/(?<rest>.+)$" {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin * always;
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Range, Content-Type" always;
            add_header Access-Control-Max-Age 86400 always;
            add_header Content-Length 0;
            add_header Content-Type text/plain;
            return 204;
        }

        secure_link $sig,$exp;
        secure_link_md5 "$exp $scope ${STREAM_SIGNING_SECRET}";
        if ($secure_link = "") { return 403; }
        if ($secure_link = "0") { return 410; }

        proxy_cache_key "$scheme$request_method$host/movies/$scope/$rest";
        proxy_pass http://storage_origin/movies/$scope/$rest;

        proxy_cache_valid 200 206 7d;
        proxy_cache_valid 404 1m;
        # Segments and book pages are never rewritten at the same key (a
        # replace goes to a new v-<tag>/ folder), so browsers may keep them
        # for 30 days. Uploaded subtitle sources (subtitles/<movieId>/, e.g.
        # an .srt from a bulk bundle) keep the operator's own file name and
        # can be re-uploaded under it, so they get the same 10 s as subtitle
        # text — see the $signed_media_expires map at the top.
        expires $signed_media_expires;
    }

    # ---- Unsigned paths: images always, video/book media only while ----
    # ---- LEGACY_UNSIGNED_MEDIA=allow (see the map at the top).       ----
    location ~* \.(m3u8|vtt)$ {
        if ($deny_unsigned_media) { return 403; }

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin * always;
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Range, Content-Type" always;
            add_header Access-Control-Max-Age 86400 always;
            add_header Content-Length 0;
            add_header Content-Type text/plain;
            return 204;
        }

        proxy_pass http://storage_origin;

        # proxy_cache_valid does not merge across levels — a location that
        # sets one replaces every inherited rule, so both codes are restated.
        proxy_cache_valid 200 206 10s;
        proxy_cache_valid 404 1m;
        expires 10s;
    }

    # Everything else: images, and (legacy switch only) unsigned media
    # segments. These are written once under a content-addressed-enough key
    # and never rewritten, so a long TTL is exactly right.
    location / {
        if ($deny_unsigned_media) { return 403; }

        # Preflight — browsers send this before a cross-origin GET that
        # carries a Range header on some implementations. Answered here
        # directly rather than forwarded upstream, since the storage origin
        # has no OPTIONS handling of its own.
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin * always;
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Range, Content-Type" always;
            add_header Access-Control-Max-Age 86400 always;
            add_header Content-Length 0;
            add_header Content-Type text/plain;
            return 204;
        }

        proxy_pass http://storage_origin;

        proxy_cache_valid 200 206 7d;
        proxy_cache_valid 404 1m;
        # Images are stored under a fresh <uuid> or <timestamp> name on every
        # upload, never overwritten, so a long browser lifetime is safe.
        expires 30d;
    }
}
