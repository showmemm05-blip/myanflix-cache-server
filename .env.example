# Copy to .env before running: cp .env.example .env

# Where the storage origin lives. Local default reaches ../storage-server's
# MinIO via the host machine's published port. On the real deployment, set
# this to the Movie Storage Server VPS's address — nothing else changes.
STORAGE_ORIGIN=host.docker.internal:9000

# Port the cache server (nginx) listens on.
CACHE_PORT=8080

# Verifies the signed token every playback link carries in its path
# (/s/<expires>/<signature>/movies/...). Must be EXACTLY the backend's
# STREAM_SIGNING_SECRET (../backend/.env) — generate one with
# `openssl rand -hex 32` and paste the same value in both files. Hex only:
# the value is substituted into the nginx config, so `$`, `"` or `;` in it
# would break the config. Required — `docker compose up` refuses to start
# the cache while this is empty, so a copied-but-unedited file cannot end
# up sharing a secret everyone knows.
STREAM_SIGNING_SECRET=

# Rollout switch. "allow": token-less /movies/videos/**, /movies/audio/** and
# /movies/books/** URLs still work (for clients that fetched a plain link
# before the backend started signing). "deny" (default): only signed /s/...
# URLs reach media.
#
# Five things are refused in BOTH modes, whatever this is set to, because
# they are never meant to be served to a browser at all: video originals
# (/movies/videos/<id>/original.*), audio originals
# (/movies/audio/<id>/original.*), uploaded subtitle SOURCE files
# (/movies/subtitles/**), the whole documents/ namespace including book
# source PDFs (/movies/documents/**), and object-store staging
# (/movies/temp/**). Catalogue images (/movies/images/**) are the opposite
# case — public by key, never denied, never signed.
#
# Deploy with "allow", flip to "deny" once every client has been redeployed
# and ~24 h (two link lifetimes) have passed.
LEGACY_UNSIGNED_MEDIA=deny
