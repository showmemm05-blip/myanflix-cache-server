# Copy to .env before running: cp .env.example .env

# Where the storage origin lives. Local default reaches ../storage-server's
# MinIO via the host machine's published port. On the real deployment, set
# this to the Movie Storage Server VPS's address — nothing else changes.
STORAGE_ORIGIN=host.docker.internal:9000

# Port the cache server (nginx) listens on.
CACHE_PORT=8080
